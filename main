    <div class="container">
        <h2>Open Website in Nieuw Tabblad</h2>
        <p>Typ hieronder de website (bijv: cloudflare.rammerhead.org/):</p>
        
        <input type="text" id="urlInput" placeholder="example.com" value="cloudflare.rammerhead.org/">
        
        <button onclick="openInNieuwTab()">Open in Nieuw Tabblad</button>
    </div>

    <script>
        function openInNieuwTab() {
            let targetUrl = document.getElementById('urlInput').value.trim();

            if (!targetUrl) {
                alert('Voer eerst een website in!');
                return;
            }

            // Verwijdert eventuele handmatige HTTPS/HTTP invoer om fouten te voorkomen
            targetUrl = targetUrl.replace(/^(https?:\/\/)?(www\.)?/, '');
            const finalUrl = 'https://' + targetUrl;

            // HTML structuur voor de onzichtbare Blob proxy-tab
            const htmlContent = `
                <!DOCTYPE html>
                <html lang="nl">
                <head>
                    <meta charset="UTF-8">
                    <title>about:blank</title>
                    <style>
                        html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #000; }
                        iframe { border: none; width: 100%; height: 100%; margin: 0; padding: 0; }
                    </style>
                </head>
                <body>
                    <iframe src="${finalUrl}"></iframe>
                </body>
                </html>
            `;

            // Genereer de Blob en open in een nieuw tabblad
            const blob = new Blob([htmlContent], { type: 'text/html' });
            const blobUrl = URL.createObjectURL(blob);
            const newWin = window.open(blobUrl, '_blank');
            
            if (!newWin) {
                alert('Pop-up is geblokkeerd! Sta pop-ups toe in je browserbalk rechtsboven.');
            }
        }
    </script>

</body>
